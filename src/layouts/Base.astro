---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { site } from '../data/site';
import { url } from '../data/url';
interface Props { title?: string; description?: string; }
const { title = `${site.name} · ${site.role}`, description = 'Shopify developer. I build Shopify stores your team can edit without me.' } = Astro.props;
const nav = [
  { href: url('/projects/'), label: 'Projects' },
  { href: url('/#about'), label: 'About' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <a class="sr-only" href="#main">Skip to content</a>
  <div class="frame">
    <header class="bb caps site-header" style="display:flex;flex-wrap:wrap;align-items:stretch;font-size:14px">
      <a href={url('/')} class="br logo" aria-label={`${site.name}, home`}>
        <span class="logo__mark" aria-hidden="true"><span>ES</span><span>ES</span></span>
        <span class="logo__name">{site.name}</span>
      </a>
      <span class="site-header__role" style="flex:1;padding:18px 24px;color:var(--muted);min-width:200px"><span>{site.role} · <span style="white-space:nowrap"><svg class="flag" width="18" height="12" viewBox="0 0 16 10" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect width="16" height="5" fill="#0057B7"/><rect y="5" width="16" height="5" fill="#FFD700"/></svg>{site.location}</span></span></span>
      <nav aria-label="Main" style="display:flex;flex-wrap:wrap">
        {nav.map((n) => <a href={n.href} class="nav-link" style="padding:18px 24px;border-left:var(--line)">{n.label}</a>)}
        <a href={url('/#start')} class="on-green" style="padding:18px 24px;border-left:var(--line);text-decoration:none"><span>Start a project <span class="arrow" aria-hidden="true">↗</span></span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="caps" style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;padding:20px 24px">
      <span>© {new Date().getFullYear()} {site.name}</span>
      <span><a href={site.linkedin}>LinkedIn</a>{site.upwork && <> · <a href={site.upwork}>Upwork</a></>}</span>
      <span>Built with Astro</span>
    </footer>
  </div>
  <script>
    // Reveal blocks on scroll and run counters once they are visible.
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const count = (el: HTMLElement) => {
      const to = Number(el.dataset.to); const suffix = el.dataset.suffix || '';
      if (reduce) { el.textContent = to + suffix; return; }
      const start = performance.now();
      const tick = (t: number) => {
        const p = Math.min(1, (t - start) / 1400); const e = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(to * e) + suffix;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) {
        if (!en.isIntersecting) continue;
        en.target.classList.add('is-in');
        en.target.querySelectorAll<HTMLElement>('[data-to]').forEach(count);
        io.unobserve(en.target);
      }
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</body>
</html>
